# Copiá este archivo como ".env" para cambiar cualquier valor. Todos son
# opcionales: si no existe .env se usan los valores por defecto de abajo.
# El archivo .env NO se sube a git.

# Base de datos (la base no se publica fuera de Docker, solo la ve la app).
POSTGRES_DB=service_app
POSTGRES_USER=service_app
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Seguridad y acceso (login)
# ---------------------------------------------------------------------------
# development (por defecto) o production. Con production:
#   - SECRET_KEY es obligatoria,
#   - las cookies de sesión solo viajan por HTTPS,
#   - NO se crea el admin por defecto (admin/admin): hay que definir ADMIN_PASSWORD.
APP_ENV=development

# Clave que firma las sesiones. Generá una larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Vacía = en desarrollo se genera sola y se guarda en la base.
SECRET_KEY=

# Administrador inicial: se crea solo si todavía no hay ningún usuario.
# Si no definís ADMIN_PASSWORD, en desarrollo se crea admin/admin y el sistema
# obliga a cambiar la contraseña en el primer ingreso.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# Cuando hay un proxy con HTTPS delante (Caddy, nginx...): 1. Sin proxy: 0.
TRUSTED_PROXIES=0

# Zona horaria (fechas y horas del sistema).
TZ=America/Argentina/Buenos_Aires
