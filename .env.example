# Copiá este archivo como ".env" para cambiar cualquier valor. Todos son
# opcionales: si no existe .env se usan los valores por defecto de abajo.
# El archivo .env NO se sube a git.

# Base de datos (la base no se publica fuera de Docker, solo la ve la app).
POSTGRES_DB=service_app
POSTGRES_USER=service_app
POSTGRES_PASSWORD=changeme

# Clave interna de Flask (sesiones/mensajes). Cambiala por algo largo y aleatorio.
SECRET_KEY=service-tecnico-dev

# Zona horaria (fechas y horas del sistema).
TZ=America/Argentina/Buenos_Aires
